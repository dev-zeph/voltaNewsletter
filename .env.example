# ============================================================================
# Bob — environment variables. Copy this file to .env.local and fill in what
# you have. Bob is designed to still work with none of these set.
# ============================================================================

# Anthropic API key, used to enrich and score sourced items with Claude
# (scoring, "why", blurb copy, section/audience tagging).
# Get one at https://console.anthropic.com/settings/keys
# OPTIONAL. Without it, Bob falls back to the heuristic scorer: simpler
# keyword-based scoring and templated blurbs. The product still runs end to
# end, the copy is just less polished.
ANTHROPIC_API_KEY=

# --- Outbound mail (Gmail SMTP) --------------------------------------------
# Without SMTP_USER and SMTP_PASS both set, Bob never sends real mail. Every
# "send" instead writes a preview .html file to <BOB_DATA_DIR>/previews/ so
# the newsletter is still fully demoable with zero credentials.

# SMTP host. OPTIONAL, defaults to smtp.gmail.com.
SMTP_HOST=smtp.gmail.com

# SMTP port. OPTIONAL, defaults to 465 (implicit TLS). Use 587 for STARTTLS.
SMTP_PORT=465

# The Gmail address Bob sends from, and the SMTP auth username.
# REQUIRED (together with SMTP_PASS) to send live mail.
SMTP_USER=

# A Gmail App Password, NOT your regular Gmail/Google account password.
# Regular passwords will fail SMTP auth (Gmail rejects them for third-party
# apps). To get one:
#   1. Turn on 2-Step Verification on the sending Google account, at
#      myaccount.google.com/security
#   2. Generate a 16-character app password at
#      myaccount.google.com/apppasswords
#   3. Paste it here with no spaces.
# REQUIRED (together with SMTP_USER) to send live mail.
SMTP_PASS=

# The From header Bob sends with, e.g. "Volta" <newsletter@voltaeffect.com>.
# OPTIONAL, defaults to "Volta" <SMTP_USER>.
MAIL_FROM=

# --- Automation --------------------------------------------------------------

# Shared secret required in the Authorization header for the cron-triggered
# run endpoint, so the public internet cannot kick off a sourcing run or
# trigger a send.
# OPTIONAL for local development. REQUIRED before deploying anywhere public,
# otherwise the run/send endpoints are open to anyone who finds the URL.
CRON_SECRET=

# --- Storage -----------------------------------------------------------------

# Directory Bob's JSON data store writes to (runs, items, recipients, issues,
# sent previews).
# OPTIONAL, defaults to ./.data relative to the project root.
BOB_DATA_DIR=
